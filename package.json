{
  "name": "personal-finance-desktop",
  "productName": "personal-finance-desktop",
  "version": "0.1.0",
  "description": "Manage your daily expense at ease",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "prebuild": "electron-vite build",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "test": "jest",
    "lint": "eslint --ext .ts,.tsx .",
    "postinstall": "npm run rebuild",
    "build": "electron-vite build",
    "build:win": "npm run build && electron-builder --win --config electron-builder.yaml",
    "build:mac": "npm run build && electron-builder --mac --config electron-builder.yaml",
    "build:linux": "npm run build && electron-builder --linux --config electron-builder.yaml"
  },
  "keywords": ["electronjs", "desktop", "application", "expense", "finance", "personal use"],
  "author": {
    "name": "Huy Vu",
    "email": "vuquanghuy2k@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^3.7.1",
    "@react-router/dev": "^7.3.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "electron": "35.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.31.0",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vite": "^6.2.1"
  },
  "dependencies": {
    "antd": "^5.24.3",
    "better-sqlite3": "^11.9.1",
    "chart.js": "^4.4.8",
    "dayjs": "^1.11.13",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "react-router": "^7.3.0"
  }
}
